# x402 Watch dashboard data
DUNE_API_KEY=your-dune-api-key

# Ask Amp page (the /amp route)
ANTHROPIC_API_KEY=your-anthropic-api-key

# DuckDB parquet glob for the settlements dataset (REQUIRED).
# Must start with /Volumes/, /Users/, s3://, https://, or r2://.
# Local SSD example shown; flip to s3://... once R2/S3 is wired up (Regime B).
AMP_PARQUET_GLOB=/Volumes/ExtremeSSD/x402-amp-datasets-data/x402-substreams/output/settlements/[0-9]*.parquet

# Optional: override the model (defaults to claude-sonnet-4-6)
# AMP_MODEL=claude-sonnet-4-6
